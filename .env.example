# Copy to .env and fill in. Placeholder values only.

# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/zack_portfolio"

# 32+ random bytes, e.g. `openssl rand -base64 32`. Used to hash rate-limit keys.
SESSION_SECRET="replace-with-a-long-random-string"

# Public origin, used for canonical URLs, sitemap and Open Graph (no trailing slash)
NEXT_PUBLIC_SITE_URL="https://example.com"

# Where uploads go: "local" (writes to ./uploads, dev or a VPS with a disk) or "cloudinary"
STORAGE_DRIVER="local"

# Required when STORAGE_DRIVER="cloudinary" (Cloudinary dashboard → API Keys → "API environment variable")
CLOUDINARY_URL="cloudinary://API_KEY:API_SECRET@CLOUD_NAME"
